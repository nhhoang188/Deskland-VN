// Resource script for deskland-rs.exe (compiled via Windows SDK rc.exe in build.rs)
// Note: RT_MANIFEST is embedded separately via /MANIFEST:EMBED in build.rs.

1 ICON "assets/app.ico"

1 VERSIONINFO
FILEVERSION     1,0,2,0
PRODUCTVERSION  1,0,2,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x00040004L
FILETYPE        0x00000001L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Deskland-VN contributors (GPL-3.0)"
            VALUE "FileDescription",  "Deskland-VN - Adaptive Live Wallpaper"
            VALUE "FileVersion",      "1.0.2.0"
            VALUE "InternalName",     "deskland-rs"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Deskland authors & Deskland-VN contributors (GPL-3.0)"
            VALUE "OriginalFilename", "Deskland-VN.exe"
            VALUE "ProductName",      "Deskland-VN"
            VALUE "ProductVersion",   "1.0.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
